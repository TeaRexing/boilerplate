{
  "name": "boilerplate",
  "version": "0.0.1",
  "description": "A super simple boilerplate to create static websites using only npm scripts",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "css:scss": "sass --no-source-map src/scss/index.scss ./public_html/index.css",
    "css:scss:prod": "sass --style=compressed src/scss/index.scss ./public_html/index.css",
    "css:lint": "stylelint src/scss/*.scss  --custom-syntax postcss-scss",
    "css:autoprefixer": "postcss -u autoprefixer -r public_html/index.css",
    "css:purify": "purifycss public_html/index.css public_html/*.html --min --info --out public_html/index.css",
    "watch:css": "onchange \"src/scss/**/*\" -- npm run build:css",
    "build:css": "npm run css:lint && npm run css:scss && npm run css:autoprefixer",
    "css:prod": "npm run css:lint && npm run css:scss:prod && npm run css:autoprefixer",
    "compress:images": "imagemin src/img/**/* --out-dir=public_html/",
    "watch:fonts": "onchange \"src/fonts/*\" -- npm run build:fonts",
    "build:fonts": "copy \"src/fonts/**/*\" public_html",
    "watch:assets": "onchange \"src/assets/*\" -- npm run build:assets",
    "build:assets": "copy \"src/assets/**/*\" public_html",
    "js:lint": "eslint src/js/**/*.js",
    "build:js": "npm run js:lint && webpack --mode=production",
    "js:dev": "npm run js:lint && webpack --mode=development",
    "watch:js": "onchange \"src/js/**/*\" -- npm run js:dev",
    "build:html": "posthtml -c posthtml.json",
    "watch:html": "onchange \"src/pages/**/*\" -- npm run build:html",
    "server:browsersync": "browser-sync start --server \"public_html\" --files \"public_html\"",
    "serve": "run-p server:*",
    "watch": "run-p build:* && run-p serve watch:*",
    "build": "run-p build:*",
    "production": "npm run purge && run-p build:html build:js css:prod build:fonts build:assets && npm run compress:images",
    "purge": "rimraf public_html/",
    "publish": "./sync.sh"
  },
  "keywords": [],
  "author": "Patrick Zempel",
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "browser-sync": "^3.0.4",
    "copy": "^0.3.2",
    "css-loader": "^7.1.4",
    "cssnano": "^8.0.9",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "htmlnano": "^3.4.0",
    "imagemin-cli": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss-cli": "^11.0.1",
    "postcss-scss": "^4.0.9",
    "posthtml": "^0.16.7",
    "posthtml-cli": "^0.10.0",
    "posthtml-lorem": "^1.0.0",
    "posthtml-modules": "^0.9.1",
    "rimraf": "^6.1.3",
    "sass": "^1.103.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "jquery": "^4.0.0"
  }
}
